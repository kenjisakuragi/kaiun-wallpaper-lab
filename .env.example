# 画像の生成方法（docs/04 §1-1）：codex（ローカルPC、ChatGPT サブスク内）/ openai（Images API、従量課金）
IMAGE_GENERATOR=codex
# codex.exe のフルパス（IMAGE_GENERATOR=codex のとき必須）
CODEX_BIN=

# OpenAI
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=
OPENAI_IMAGE_QUALITY=medium
OPENAI_TEXT_MODEL=
IMAGE_BUDGET_USD=80
IMAGE_CONCURRENCY=3

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# R2 の置き方：wrangler（手元、wrangler login の認証。キー不要）/ s3（CI 用、下のキーが必要）
STORAGE_MODE=wrangler
# R2 の S3 互換 API 用（STORAGE_MODE=s3 のとき。R2 の API トークン画面で発行）
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_RANDOM_PREFIX=
D1_DATABASE_ID=
# バッチの DB：local（node:sqlite、開発用）/ wrangler（手元から本番 D1、wrangler login の認証）/ d1（CI 用、API トークン）
DB_MODE=local
LOCAL_DB_PATH=out/local.db
EDGE_HOST=

# Threads API
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_AUTO_REPLY_MODE=approve
THREADS_AUTO_REPLY_DAILY_CAP=50
THREADS_REPLY_WINDOW_HOURS=72

# Instagram Graph API
IG_USER_ID=
IG_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=

# LINE Messaging API（edge 側は wrangler secret で設定）
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_ADD_FRIEND_URL=
LINE_MONTHLY_PUSH_LIMIT=200
PRIVACY_POLICY_URL=

# A/B・ハッシュ・暗号化
AB_SALT=
USER_HASH_SALT=
USER_ID_ENC_KEY=

# 運用設定
TIMEZONE=Asia/Tokyo
POST_TIME_THREADS=07:00
POST_TIME_INSTAGRAM=19:00
TEXT_SIMILARITY_THRESHOLD=0.8
# NG ワード検査：off / warn（記録のみ・送る）/ block（送らない）。docs/09 #16
NG_WORD_MODE=warn
